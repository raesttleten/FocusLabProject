rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function hasRole(rol) {
      return signedIn() && exists(profilePath(request.auth.uid)) && myProfile().rol == rol;
    }

    function isResearcher() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/investigadoras_autorizadas/$(request.auth.token.email))
        && get(/databases/$(database)/documents/investigadoras_autorizadas/$(request.auth.token.email)).data.activa == true;
    }

    function isTeacherOf(uid) {
      return hasRole('docente')
        && exists(profilePath(uid))
        && get(profilePath(uid)).data.rol == 'estudiante'
        && get(profilePath(uid)).data.grupoId == myProfile().grupoId;
    }

    function isStudentOwner(uid) {
      return signedIn() && request.auth.uid == uid && hasRole('estudiante');
    }

    function canReadProgress(uid) {
      return signedIn() && (request.auth.uid == uid || isTeacherOf(uid) || isResearcher());
    }

    function validColor(color) {
      return color == null || color in ['Lila', 'Verde', 'Rosa', 'Azul'];
    }

    function validMascota(mascota) {
      return mascota is map
        && mascota.keys().hasOnly(['nombre', 'prenda'])
        && mascota.nombre is string
        && mascota.nombre.size() >= 1
        && mascota.nombre.size() <= 12
        && mascota.prenda in ['lila', 'rosa', 'negro', 'verde'];
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (hasRole('docente') && resource.data.rol == 'estudiante' && resource.data.grupoId == myProfile().grupoId)
        || isResearcher()
      );

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.rol == 'estudiante'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['color', 'mascota'])
        && validColor(request.resource.data.get('color', null))
        && (!('mascota' in request.resource.data) || validMascota(request.resource.data.mascota));

      allow create: if hasRole('docente')
        && request.resource.data.keys().hasOnly(['rol', 'codigo', 'grupoId', 'color', 'mascota'])
        && request.resource.data.rol == 'estudiante'
        && request.resource.data.codigo is string
        && request.resource.data.codigo.matches('^E[0-9]{2,3}$')
        && request.resource.data.grupoId == myProfile().grupoId
        && request.resource.data.color == null
        && validMascota(request.resource.data.mascota);

      allow delete: if false;
    }

    match /progreso/{uid}/dias/{dia} {
      allow read: if canReadProgress(uid);
      allow create, update: if isStudentOwner(uid)
        && dia in ['1', '2', '3']
        && request.resource.data.keys().hasOnly(['estado', 'fechaInicio', 'fechaFin', 'transicionMostrada', 'cuentos', 'preguntaActual'])
        && request.resource.data.get('estado', 'disponible') in ['bloqueado', 'disponible', 'terminado'];
      allow delete: if false;
    }

    match /progreso/{uid}/respuestas/{respuestaId} {
      function validRespuesta() {
        let data = request.resource.data;
        return data.keys().hasOnly(['dia', 'cuento', 'indice', 'tipo', 'componente', 'intentos', 'opcionesTocadas', 'aciertoEnIntento', 'segundosHastaAcertar', 'opcionElegida', 'completada', 'mostradaEn', 'completadaEn'])
          && data.dia is int
          && data.cuento in ['c1', 'c2']
          && data.indice is int
          && respuestaId == string(data.dia) + '_' + data.cuento + '_' + string(data.indice);
      }

      allow read: if canReadProgress(uid);
      allow create: if isStudentOwner(uid)
        && respuestaId.matches('^[1-3]_c[12]_[0-2]$')
        && validRespuesta();
      allow update: if isStudentOwner(uid)
        && resource.data.get('completada', false) != true
        && validRespuesta();
      allow delete: if false;
    }

    match /progreso/{uid}/lecturas/{lecturaId} {
      allow read: if canReadProgress(uid);
      allow create: if isStudentOwner(uid)
        && request.resource.data.keys().hasOnly(['dia', 'cuento', 'segundos', 'modo', 'fecha'])
        && request.resource.data.modo in ['primera', 'repaso'];
      allow update, delete: if false;
    }

    match /progreso/{uid}/juegos/{partidaId} {
      allow read: if canReadProgress(uid);
      allow create: if isStudentOwner(uid)
        && request.resource.data.keys().hasOnly(['juego', 'fechaInicio', 'duracion', 'metricas']);
      allow update, delete: if false;
    }

    match /progreso/{uid}/actividad/{tramoId} {
      allow read: if canReadProgress(uid);
      allow create, update: if isStudentOwner(uid)
        && request.resource.data.keys().hasOnly(['inicio', 'fin', 'segundosActivos', 'segundosInactivos', 'salidas']);
      allow delete: if false;
    }

    match /investigadoras_autorizadas/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
